<Window x:Class="Cocytus.App.Views.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização do Cocytus"
        Icon="/Assets/cocytus.ico"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CyBackground}"
        Foreground="{StaticResource CyText}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <StackPanel Margin="24,20,24,20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Image Source="/Assets/cocytus.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
    <TextBlock Text="{Binding Details}" Style="{StaticResource CyMutedText}" Margin="0,0,0,12" />

    <TextBlock Text="Novidades" Style="{StaticResource CySectionTitle}" />
    <Border Background="{StaticResource CySurface}" BorderBrush="{StaticResource CyBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
    <TextBlock Margin="0,6,0,0">
      <Hyperlink Command="{Binding OpenPageCommand}" Foreground="{StaticResource CyAccent}">Ver a release no GitHub</Hyperlink>
    </TextBlock>

    <TextBlock Text="{Binding BusyWarning}" Foreground="{StaticResource CySuspicious}" TextWrapping="Wrap" Margin="0,10,0,0" />
    <TextBlock Style="{StaticResource CyMutedText}" Margin="0,10,0,0"
               Text="O pacote é baixado do GitHub e conferido pelo SHA-256 publicado na release. O Cocytus fecha, instala a versão nova na mesma pasta e abre de novo. Bases, quarentena, histórico e configurações são mantidos." />

    <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" />
    </StackPanel>
    <TextBlock Text="{Binding Status}" Foreground="{StaticResource CyAccent}" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Pular esta versão" Command="{Binding SkipCommand}" Style="{StaticResource CyButton}"
              Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
      <Button Content="Agora não" Command="{Binding LaterCommand}" Style="{StaticResource CyButton}"
              Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
      <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource CyButton}"
              Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
      <Button Content="Atualizar agora" Command="{Binding UpdateCommand}" Style="{StaticResource CyPrimaryButton}" Margin="0" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
