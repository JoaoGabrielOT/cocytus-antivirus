<UserControl x:Class="Cocytus.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="StateText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Foreground" Value="{StaticResource CyOk}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter Property="Foreground" Value="{StaticResource CyMuted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Otimização" Style="{StaticResource CyPageTitle}" />
      <TextBlock Style="{StaticResource CyPageSubtitle}"
                 Text="Uso do computador, limpeza de arquivos temporários e programas que iniciam com o Windows. Nada é alterado sem você confirmar." />
    </StackPanel>

    <TabControl Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
      <!-- Uso -->
      <TabItem Header="Uso do computador">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource CyCard}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshUsageCommand}" Style="{StaticResource CyButton}" Margin="0" />
                <TextBlock Text="Discos e memória" Style="{StaticResource CySectionTitle}" VerticalAlignment="Center" Margin="0" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource CyMutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Memória (RAM)" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Style="{StaticResource CyMutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <TextBlock Text="{Binding UsageStatus}" Style="{StaticResource CyMutedText}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CyCard}" Margin="0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Programas que mais usam memória" Style="{StaticResource CySectionTitle}" />
                <DataGrid ItemsSource="{Binding TopMemory}" Style="{StaticResource CyGrid}" AutomationProperties.Name="Programas que mais usam memória">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Memória" Binding="{Binding MemoryText}" Width="110" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CyCard}" Margin="0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Programas que mais usam CPU" Style="{StaticResource CySectionTitle}" />
                <DataGrid ItemsSource="{Binding TopCpu}" Style="{StaticResource CyGrid}" AutomationProperties.Name="Programas que mais usam CPU">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" />
                    <DataGridTextColumn Header="Memória" Binding="{Binding MemoryText}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Limpeza -->
      <TabItem Header="Limpeza">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CyCard}">
              <StackPanel>
                <TextBlock Text="Arquivos temporários" Style="{StaticResource CySectionTitle}" />
                <TextBlock Style="{StaticResource CyMutedText}" Margin="0,0,0,10"
                           Text="Analise primeiro para ver quanto espaço cada item ocupa. Links e junções não são seguidos; arquivos em uso, somente leitura ou do sistema são mantidos." />
                <ItemsControl ItemsSource="{Binding Categories}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CyMutedText}" />
                          </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding Estimate}" VerticalAlignment="Center" TextAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Analisar" Command="{Binding AnalyzeCommand}" Style="{StaticResource CyPrimaryButton}" />
                  <Button Content="Limpar…" Command="{Binding CleanCommand}" Style="{StaticResource CyDangerButton}" />
                </StackPanel>
                <TextBlock Text="{Binding CleanupStatus}" Foreground="{StaticResource CyAccent}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CyCard}">
              <StackPanel>
                <TextBlock Text="Lixeira" Style="{StaticResource CySectionTitle}" />
                <TextBlock Text="{Binding RecycleText}" Margin="0,0,0,10" />
                <Button Content="Esvaziar Lixeira…" Command="{Binding EmptyRecycleCommand}" Style="{StaticResource CyDangerButton}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Inicialização -->
      <TabItem Header="Inicialização">
        <Border Style="{StaticResource CyCard}" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CyMutedText}" Margin="0,0,0,10"
                       Text="Desativar não apaga nada: o programa só deixa de abrir com o Windows (o mesmo ajuste do Gerenciador de Tarefas) e pode ser reativado aqui. Itens de todos os usuários pedem confirmação de administrador do Windows." />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Atualizar" Command="{Binding RefreshStartupCommand}" Style="{StaticResource CyButton}" />
                <Button Content="Mostrar no Explorador" Command="{Binding RevealStartupCommand}" Style="{StaticResource CyButton}" />
                <Button Content="Ativar" Command="{Binding EnableStartupCommand}" Style="{StaticResource CyButton}" />
                <Button Content="Desativar" Command="{Binding DisableStartupCommand}" Style="{StaticResource CyDangerButton}" Margin="0" />
              </StackPanel>
              <TextBlock Text="{Binding StartupStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource CyAccent}" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding StartupItems}" SelectedItem="{Binding SelectedStartup}" Style="{StaticResource CyGrid}"
                      SelectionMode="Single" AutomationProperties.Name="Programas de inicialização">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.2*" />
                <DataGridTemplateColumn Header="Estado" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StateText}" Style="{StaticResource StateText}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="1.3*" />
                <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="2*" />
                <DataGridTextColumn Header="" Binding="{Binding AdminText}" Width="130" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
