<UserControl x:Class="Cocytus.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="OutcomeText" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource CyNotScanned}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Outcome}" Value="Threat">
          <Setter Property="Foreground" Value="{StaticResource CyThreat}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Outcome}" Value="Suspicious">
          <Setter Property="Foreground" Value="{StaticResource CySuspicious}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Outcome}" Value="ReadError">
          <Setter Property="Foreground" Value="{StaticResource CyReadError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Verificação" Style="{StaticResource CyPageTitle}" />
      <TextBlock Style="{StaticResource CyPageSubtitle}"
                 Text="O conteúdo é lido pelo Cocytus e analisado pelo ClamAV; nenhum arquivo é aberto ou executado." />
    </StackPanel>

    <!-- Tipo de verificação e alvos -->
    <Border Grid.Row="1" Style="{StaticResource CyCard}">
      <StackPanel>
        <UniformGrid Columns="3" IsEnabled="{Binding IsIdle}">
          <RadioButton GroupName="ScanMode" IsChecked="{Binding IsQuickMode}" Style="{StaticResource CyModeCard}"
                       AutomationProperties.Name="Verificação rápida">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="{StaticResource CyIconFont}" FontSize="16" Margin="0,1,8,0" Foreground="{StaticResource CyAccent}" />
                <TextBlock Text="Verificação rápida" FontWeight="SemiBold" FontSize="14" />
              </StackPanel>
              <TextBlock Text="Programas em execução, inicialização, Downloads, Área de Trabalho, Temp e AppData." Style="{StaticResource CyMutedText}" Margin="0,4,0,0" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="ScanMode" IsChecked="{Binding IsFullMode}" Style="{StaticResource CyModeCard}"
                       AutomationProperties.Name="Verificação completa">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource CyIconFont}" FontSize="16" Margin="0,1,8,0" Foreground="{StaticResource CyAccent}" />
                <TextBlock Text="Verificação completa" FontWeight="SemiBold" FontSize="14" />
              </StackPanel>
              <TextBlock Text="Todos os arquivos de todas as unidades fixas. Pode levar horas." Style="{StaticResource CyMutedText}" Margin="0,4,0,0" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="ScanMode" IsChecked="{Binding IsSelectedMode}" Style="{StaticResource CyModeCard}" Margin="0"
                       AutomationProperties.Name="Verificação selecionada">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource CyIconFont}" FontSize="16" Margin="0,1,8,0" Foreground="{StaticResource CyAccent}" />
                <TextBlock Text="Verificação selecionada" FontWeight="SemiBold" FontSize="14" />
              </StackPanel>
              <TextBlock Text="Só os arquivos e pastas que você escolher (ou arrastar para a lista)." Style="{StaticResource CyMutedText}" Margin="0,4,0,0" />
            </StackPanel>
          </RadioButton>
        </UniformGrid>

        <!-- Rápida -->
        <TextBlock Visibility="{Binding IsQuickMode, Converter={StaticResource BoolToVis}}" Style="{StaticResource CyMutedText}" Margin="0,12,0,0"
                   Text="Analisa o executável de cada programa em execução e de cada item que inicia com o Windows (registro Run/RunOnce, pastas Inicializar e serviços automáticos), as pastas Downloads, Área de Trabalho e Temp inteiras e, em AppData (Roaming, Local e LocalLow), só executáveis e scripts." />

        <!-- Completa -->
        <StackPanel Visibility="{Binding IsFullMode, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
          <TextBlock Style="{StaticResource CyMutedText}">
            <Run Text="Unidades:" /> <Run Text="{Binding DrivesText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CyText}" />
          </TextBlock>
          <TextBlock Style="{StaticResource CyMutedText}" Margin="0,4,0,0"
                     Text="Pendrives, unidades de rede e arquivos só na nuvem ficam de fora. A pasta de dados e a pasta do Cocytus não são verificadas. Arquivos do sistema em uso aparecem como erro de leitura." />
        </StackPanel>

        <!-- Selecionada -->
        <Grid Visibility="{Binding IsSelectedMode, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ListBox x:Name="TargetsList" Grid.Column="0" Height="96"
                   ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                   AllowDrop="True" Drop="OnTargetsDrop" DragOver="OnTargetsDragOver"
                   Background="{StaticResource CySurfaceAlt}" BorderBrush="{StaticResource CyBorder}" BorderThickness="1"
                   AutomationProperties.Name="Arquivos e pastas a verificar" />
          <TextBlock Grid.Column="0" IsHitTestVisible="False" Margin="14,0" VerticalAlignment="Center"
                     Foreground="{StaticResource CyMuted}" Text="Nenhum item selecionado. Use os botões ao lado ou arraste arquivos e pastas para cá.">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Targets.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Button Content="Adicionar arquivos…" Command="{Binding AddFilesCommand}" Style="{StaticResource CyButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
            <Button Content="Adicionar pasta…" Command="{Binding AddFoldersCommand}" Style="{StaticResource CyButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Remover" Command="{Binding RemoveTargetCommand}" Style="{StaticResource CyButton}" Margin="0,0,6,0" />
              <Button Content="Limpar" Command="{Binding ClearTargetsCommand}" Style="{StaticResource CyButton}" Margin="0" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Iniciar verificação" Command="{Binding StartCommand}" Style="{StaticResource CyPrimaryButton}" />
          <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource CyButton}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Progresso -->
    <Border Grid.Row="2" Style="{StaticResource CyCard}">
      <StackPanel>
        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource CySectionTitle}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="{Binding IsRunning}" Height="4" Margin="0,0,0,8"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource CyMutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,10" />
        <UniformGrid Columns="6">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Processed}" Style="{StaticResource CyCounterNumber}" />
            <TextBlock Text="{Binding Found, StringFormat='processados de {0} encontrados'}" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding NoThreat}" Style="{StaticResource CyCounterNumber}" />
            <TextBlock Text="sem detecção" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Threats}" Style="{StaticResource CyCounterNumber}" Foreground="{StaticResource CyThreat}" />
            <TextBlock Text="ameaças" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Suspicious}" Style="{StaticResource CyCounterNumber}" Foreground="{StaticResource CySuspicious}" />
            <TextBlock Text="suspeitos" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding NotScanned}" Style="{StaticResource CyCounterNumber}" Foreground="{StaticResource CyNotScanned}" />
            <TextBlock Text="não analisados" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding ReadErrors}" Style="{StaticResource CyCounterNumber}" Foreground="{StaticResource CyReadError}" />
            <TextBlock Text="erros de leitura" Style="{StaticResource CyCounterLabel}" />
          </StackPanel>
        </UniformGrid>
        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
          <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{StaticResource CyText}" />
          <TextBlock Text="{Binding EngineText, StringFormat='Mecanismo: {0}'}" Style="{StaticResource CyMutedText}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding LimitationsText}" Style="{StaticResource CyMutedText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource CyMutedText}" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Resultados -->
    <Border Grid.Row="3" Style="{StaticResource CyCard}" Margin="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Mostrar no Explorador" Command="{Binding RevealCommand}" Style="{StaticResource CyButton}" />
            <Button Content="Mover para a quarentena…" Command="{Binding QuarantineCommand}" Style="{StaticResource CyDangerButton}" Margin="0" />
          </StackPanel>
          <TextBlock Text="{Binding ResultsHeader}" Style="{StaticResource CySectionTitle}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>
        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                  Style="{StaticResource CyGrid}" SelectionMode="Extended" SelectionChanged="OnResultsSelectionChanged"
                  AutomationProperties.Name="Resultados da verificação">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Categoria" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding OutcomeText}" Style="{StaticResource OutcomeText}" VerticalAlignment="Center" Margin="4,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Arquivo" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,2" ToolTip="{Binding Path}">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{StaticResource CyMuted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Detecção / motivo" Binding="{Binding Name}" Width="1.4*" />
            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="2*" />
            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" />
            <DataGridTextColumn Header="Situação" Binding="{Binding State}" Width="150" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
