<UserControl x:Class="Cocytus.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Quarentena" Style="{StaticResource CyPageTitle}" />
      <TextBlock Style="{StaticResource CyPageSubtitle}"
                 Text="Arquivos movidos para cá ficam cifrados e não podem ser abertos nem executados por engano. A restauração confere o SHA-256 e nunca sobrescreve um arquivo existente." />
    </StackPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource CyCard}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Atualizar lista" Command="{Binding RefreshCommand}" Style="{StaticResource CyButton}" />
          <Button Content="Abrir pasta da quarentena" Command="{Binding OpenFolderCommand}" Style="{StaticResource CyButton}" />
          <Button Content="Restaurar…" Command="{Binding RestoreCommand}" Style="{StaticResource CyButton}" />
          <Button Content="Excluir definitivamente…" Command="{Binding DeleteCommand}" Style="{StaticResource CyDangerButton}" Margin="0" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource CyMutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
      </DockPanel>
    </Border>
    <Border Style="{StaticResource CyCard}" Margin="0">
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource CyGrid}" SelectionMode="Single"
                AutomationProperties.Name="Itens em quarentena">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Data" Binding="{Binding DateText}" Width="130" />
          <DataGridTemplateColumn Header="Arquivo original" Width="2.2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2" ToolTip="{Binding OriginalPath}">
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding OriginalPath}" FontSize="11.5" Foreground="{StaticResource CyMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="1.4*" />
          <DataGridTextColumn Header="Motor / base" Binding="{Binding EngineText}" Width="1*" />
          <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" />
          <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="1.4*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
