<UserControl x:Class="Cocytus.App.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Desinstalar apps" Style="{StaticResource CyPageTitle}" />
      <TextBlock Style="{StaticResource CyPageSubtitle}"
                 Text="Programas e apps da Microsoft Store instalados. A desinstalação usa o desinstalador oficial de cada programa; depois, o Cocytus procura restos e mostra o que encontrou antes de remover." />
    </StackPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource CyCard}">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Atualizar lista" Command="{Binding RefreshCommand}" Style="{StaticResource CyButton}" />
            <Button Content="Abrir local" Command="{Binding OpenLocationCommand}" Style="{StaticResource CyButton}" />
            <Button Content="Parar de aguardar" Command="{Binding StopWaitingCommand}" Style="{StaticResource CyButton}" />
            <Button Content="Desinstalar…" Command="{Binding UninstallCommand}" Style="{StaticResource CyDangerButton}" Margin="0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" VerticalAlignment="Center"
                     AutomationProperties.Name="Buscar por nome ou editor" ToolTip="Buscar por nome ou editor" />
            <CheckBox Content="Mostrar apps da Microsoft Store" IsChecked="{Binding ShowStoreApps}" VerticalAlignment="Center" Margin="16,0,0,0" />
          </StackPanel>
        </DockPanel>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
          <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{StaticResource CyMuted}" />
          <Run Text="  " />
          <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource CyAccent}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Restos -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource CyCard}" Margin="0,12,0,0"
            Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Fechar" Command="{Binding DismissLeftoversCommand}" Style="{StaticResource CyButton}" />
            <Button Content="Remover selecionados…" Command="{Binding RemoveLeftoversCommand}" Style="{StaticResource CyDangerButton}" Margin="0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding LeftoversTitle}" Style="{StaticResource CySectionTitle}" Margin="0" />
            <TextBlock Style="{StaticResource CyMutedText}"
                       Text="Desmarque o que quiser manter. Pastas vão para a Lixeira; chaves de registro são salvas em .reg antes de apagar." />
          </StackPanel>
        </DockPanel>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Leftovers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsChecked}">
                    <StackPanel>
                      <TextBlock>
                        <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Path, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource CyMutedText}" />
                    </StackPanel>
                  </CheckBox>
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource CyAccent}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource CyCard}" Margin="0">
      <DataGrid ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" Style="{StaticResource CyGrid}" SelectionMode="Single"
                AutomationProperties.Name="Apps instalados">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" Width="1.2*" />
          <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="110" />
          <DataGridTextColumn Header="Instalado em" Binding="{Binding InstalledText}" Width="100" />
          <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" />
          <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="170" />
          <DataGridTextColumn Header="Para" Binding="{Binding ScopeText}" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
