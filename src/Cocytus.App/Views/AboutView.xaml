<UserControl x:Class="Cocytus.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Image Source="/Assets/cocytus.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Cocytus" Style="{StaticResource CyPageTitle}" Margin="0" />
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource CyMutedText}" />
        </StackPanel>
      </StackPanel>

      <Border Style="{StaticResource CyCard}">
        <StackPanel>
          <TextBlock Text="O que o Cocytus faz (e o que não faz)" Style="{StaticResource CySectionTitle}" />
          <TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CyCard}">
        <StackPanel>
          <TextBlock Text="Situação dos recursos" Style="{StaticResource CySectionTitle}" />
          <DataGrid ItemsSource="{Binding Features}" Style="{StaticResource CyGrid}" AutomationProperties.Name="Situação dos recursos">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Recurso" Binding="{Binding Feature}" Width="1.4*" />
              <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="Observação" Binding="{Binding Note}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CyCard}">
        <StackPanel>
          <TextBlock Text="Arquivo de teste" Style="{StaticResource CySectionTitle}" />
          <TextBlock TextWrapping="Wrap" Style="{StaticResource CyMutedText}">
            Para testar sem malware, crie um arquivo de texto que comece com o marcador abaixo. Ele é detectado de propósito
            pela assinatura própria "Cocytus.ArquivoDeTeste" e serve para conferir a verificação e a quarentena.
          </TextBlock>
          <TextBox Text="{Binding TestMarker, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Margin="0,8" HorizontalAlignment="Left" MinWidth="380" />
          <Button Content="Criar arquivo de teste…" Command="{Binding CreateTestFileCommand}" Style="{StaticResource CyButton}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CyCard}">
        <StackPanel>
          <TextBlock Text="Licenças" Style="{StaticResource CySectionTitle}" />
          <TextBlock TextWrapping="Wrap">
            O Cocytus é software livre sob a GNU GPL versão 2. Motor de detecção: ClamAV (Cisco Talos, GPL-2.0), executado como
            processo separado; bases de assinaturas oficiais do ClamAV, baixadas pelo freshclam. Interface: .NET e WPF (MIT).
            Histórico: Microsoft.Data.Sqlite (MIT) e SQLite (domínio público). Detalhes em THIRD-PARTY-NOTICES.md.
          </TextBlock>
          <TextBlock Text="{Binding EngineText, StringFormat='Motor instalado: {0}'}" Style="{StaticResource CyMutedText}" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource CyMutedText}" Margin="0,8,0,0"
                     Text="Projeto independente. Não tem relação com fabricantes de antivírus comerciais e não reaproveita código, marcas, textos ou bases deles." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
