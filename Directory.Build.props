<Project>
  <PropertyGroup>
    <!-- 10.0.19041: API do Windows para listar e remover apps da Microsoft Store (PackageManager) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>0.2.0</Version>
    <Company>Projeto Cocytus</Company>
    <Product>Cocytus</Product>
    <Copyright>Copyright (C) 2026 João Gabriel Oliveira Tavares. Licenciado sob a GPL-2.0.</Copyright>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
